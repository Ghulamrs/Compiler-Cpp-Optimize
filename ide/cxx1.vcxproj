  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <!-- The headers an installation ships, beside cpp11.exe (docs\Runtime_Design.md 5.3): include\c++ holds its C++
       headers, which is where cpp11 looks first, with the C ones they wrap in include\c and include\win - one set
       with c90's (toolchain\include), which c90's project writes there. For one release the earlier layout too:
       include\ holding both, with <sys/types.h> and <sys/stat.h> in include\sys. The list is made inside the target,
       so Visual Studio shows no wildcard item; the check is off so that Visual Studio runs the copy even when
       cpp11.exe is up to date. -->
  <PropertyGroup>
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
  </PropertyGroup>
  <Target Name="Cpp11Headers" AfterTargets="Build">
    <ItemGroup>
      <Cpp11Header Include="$(ProjectDir)..\include\*" />
      <Cpp11CHeader Include="$(ProjectDir)..\..\..\include\c\*.h;$(ProjectDir)..\..\..\include\win\*.h" />
      <Cpp11SysHeader Include="$(ProjectDir)..\..\..\include\c\sys\*.h" />
    </ItemGroup>
    <Copy SourceFiles="@(Cpp11Header)" DestinationFolder="$(OutDir)include\c++" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(Cpp11Header);@(Cpp11CHeader)" DestinationFolder="$(OutDir)include" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(Cpp11SysHeader)" DestinationFolder="$(OutDir)include\sys" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="Cpp11HeadersClean" AfterTargets="Clean">
    <ItemGroup>
      <Cpp11Header Include="$(ProjectDir)..\include\*" />
      <Cpp11CHeader Include="$(ProjectDir)..\..\..\include\c\*.h;$(ProjectDir)..\..\..\include\win\*.h" />
      <Cpp11HeaderCopy Include="@(Cpp11Header->'$(OutDir)include\%(Filename)%(Extension)');@(Cpp11CHeader->'$(OutDir)include\%(Filename)%(Extension)')" />
    </ItemGroup>
    <Delete Files="@(Cpp11HeaderCopy)" />
    <RemoveDir Directories="$(OutDir)include\c++;$(OutDir)include\sys" />
  </Target>
