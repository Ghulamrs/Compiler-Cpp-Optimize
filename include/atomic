// <atomic> - [atomics]: atomic types, atomic_flag, the free functions and the fences.
//
// On x86-64 and arm64 an atomic scalar of 1, 2, 4 or 8 bytes - bool, the integers, an enumeration, a pointer,
// float and double - is lock-free since 1.75: its operations are the processor's own, `lock cmpxchg`, `lock xadd`
// and `xchg` or an exclusive load-and-store pair, in sixteen functions the backend writes into each file that
// calls them (Spelling.h's atomicHelper), as it writes atomic_flag's exchange. is_lock_free() says true for
// those and the ATOMIC_*_LOCK_FREE macros 2. Every order asked for is given as memory_order_seq_cst, which is
// the strongest. Any other type - a class, a pointer to member, long double where it is 16 bytes - and every
// type on the C6747 takes the program's one lock (<__threads>): each operation is then indivisible and
// sequentially consistent too, and is_lock_free() says false ([atomics.lockfree] allows either).
#ifndef _CXX1_ATOMIC
#define _CXX1_ATOMIC

#include <cstddef>
#include <cstdint>
#include <cstring>
#include <type_traits>
#include <__threads>

#if defined(__x86_64__) || defined(__aarch64__)
#define _CXX1_ATOMIC_WORDS 1
#define _CXX1_ATOMIC_LOCK_FREE 2
#else
#define _CXX1_ATOMIC_WORDS 0
#define _CXX1_ATOMIC_LOCK_FREE 0
#endif

namespace std {

// [atomics.order]
typedef enum memory_order {
    memory_order_relaxed, memory_order_consume, memory_order_acquire,
    memory_order_release, memory_order_acq_rel, memory_order_seq_cst
} memory_order;
template <class T> T kill_dependency(T y) noexcept { return y; }

