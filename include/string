// <string> - one class template, and the operators around it.
//
// **Not `<cstring>`**, which is C's `string.h` under `std::`. This is the
// class; that is the byte functions. The two names are one letter apart and a
// program that reaches for the wrong one gets no error, so it is worth saying
// twice.
//
// What is here is what a program actually calls, and no more: the tree this
// library was written for uses seventeen members of this class, and each is
// below. There is no small-string optimisation - every string owns a heap
// buffer, even an empty one does not - and no allocator parameter, because
// there is nowhere to put one that anything would read.
//
// **`basic_string<C>` since 2026-09-26**, so that `wstring` is the same class
// over `wchar_t` rather than a second copy of it; there is no `char_traits`,
// the three things a traits class would answer being the three helpers below.
//
// **The class owns memory, which is why it defines all four of the special
// members** rather than letting the compiler copy its bytes: two strings
// sharing a buffer would free it twice, and that is the failure that prints the
// right answer first.
#ifndef _CXX1_STRING
#define _CXX1_STRING

#include <cstddef>
#include <cstdlib>
#include <cstring>

namespace std {

// **`at` throws `out_of_range`, and `out_of_range` holds a `string`**, so the
// class cannot be named here. What `at` calls is declared here and defined at
// the end of <stdexcept>, which the end of this header includes: the same
// shape libstdc++ gives it, with the definition in every unit rather than in
// a library, as the operators below are.
inline void __throw_out_of_range(const char *what);

// The traits a basic_string needs, as three functions: length, order, membership.
template <class C> inline std::size_t __cxx1_length(const C *s) {
    std::size_t n = 0;
    if (s != 0) while (s[n] != 0) n++;
    return n;
}
template <class C> inline int __cxx1_compare(const C *a, const C *b) {
    std::size_t i = 0;
    while (a[i] != 0 && a[i] == b[i]) i++;
    return a[i] < b[i] ? -1 : a[i] == b[i] ? 0 : 1;
}
template <class C> inline bool __cxx1_holds(const C *wanted, C c) {
    for (std::size_t i = 0; wanted[i] != 0; i++)
        if (wanted[i] == c) return true;
    return false;
}

template <class C>
class basic_string {
public:
    typedef std::size_t size_type;
    typedef C value_type;
    // -1 as a size: "to the end", or "not found". Every function that takes a
    // length accepts it and every search returns it.
    static const size_type npos = (size_type)-1;

    basic_string() { init(0, 0); }
    basic_string(const C *s) { init(s, __cxx1_length(s)); }
    basic_string(const C *s, size_type n) { init(s, n); }
    basic_string(const basic_string &o) { init(o.buf_, o.len_); }
    basic_string(size_type n, C c) {
        // Before the first reserve the members hold the frame, and reserve reads them.
        buf_ = 0; len_ = 0; cap_ = 0;
        reserveExactly(n);
        for (size_type i = 0; i < n; i++) buf_[i] = c;
        len_ = n;
        buf_[len_] = 0;
    }
    ~basic_string() { std::free(buf_); }

    basic_string &operator=(const basic_string &o) {
        // Self-assignment first, because the next line frees what it would
        // then copy from.
        if (this != &o) assignFrom(o.buf_, o.len_);
        return *this;
    }
    basic_string &operator=(const C *s) {
        assignFrom(s, __cxx1_length(s));
        return *this;
    }
    basic_string &operator=(C c) { assignFrom(&c, 1); return *this; }

    basic_string &operator+=(const basic_string &o) { return appendUnits(o.buf_, o.len_); }
    basic_string &operator+=(const C *s) {
        return appendUnits(s, __cxx1_length(s));
    }
    basic_string &operator+=(C c) { return appendUnits(&c, 1); }

    C &operator[](size_type i) { return buf_[i]; }
    const C &operator[](size_type i) const { return buf_[i]; }
    // [string.access]: the checked form of the same.
    C &at(size_type i) {
        if (i >= len_) std::__throw_out_of_range("string::at");
        return buf_[i];
    }
    const C &at(size_type i) const {
        if (i >= len_) std::__throw_out_of_range("string::at");
        return buf_[i];
    }

    size_type size() const { return len_; }
    size_type length() const { return len_; }
    bool empty() const { return len_ == 0; }
    const C *c_str() const { return buf_; }
    const C *data() const { return buf_; }

    void clear() { len_ = 0; buf_[0] = 0; }
    void push_back(C c) { appendUnits(&c, 1); }
    void pop_back() { if (len_ != 0) { len_--; buf_[len_] = 0; } }

    C &back() { return buf_[len_ - 1]; }
    const C &back() const { return buf_[len_ - 1]; }
    C &front() { return buf_[0]; }
    const C &front() const { return buf_[0]; }

    C *begin() { return buf_; }
    C *end() { return buf_ + len_; }
    const C *begin() const { return buf_; }
    const C *end() const { return buf_ + len_; }

    basic_string &append(const basic_string &o) { return appendUnits(o.buf_, o.len_); }
    basic_string &append(const C *s) {
        return appendUnits(s, __cxx1_length(s));
    }
    basic_string &append(const C *s, size_type n) { return appendUnits(s, n); }
    basic_string &append(size_type n, C c) {
        for (size_type i = 0; i < n; i++) appendUnits(&c, 1);
        return *this;
    }

    // **`buf_ == 0` is a real state here, and not only before construction.**
    // This library's `vector` assigns into raw `calloc`'d storage - placement
    // new is refused by this compiler, so there is no way to construct an
    // element in place - and a zeroed slot is a `string` with a null buffer,
    // zero length and zero capacity. Without the second test, `reserve(0)` on
    // one did nothing and the `buf_[len_] = 0` that follows every write went to
    // a null pointer: `std::vector<std::string> s(2);` crashed.
    void reserve(size_type n) { if (n > cap_ || buf_ == 0) reserveExactly(n); }

    void resize(size_type n, C c) {
        if (n > len_) {
            reserve(n);
            for (size_type i = len_; i < n; i++) buf_[i] = c;
        }
        len_ = n;
        buf_[len_] = 0;
    }
    void resize(size_type n) { resize(n, 0); }

    basic_string substr(size_type pos, size_type n) const {
        if (pos > len_) pos = len_;
        size_type have = len_ - pos;
        return basic_string(buf_ + pos, n > have ? have : n);
    }
    basic_string substr(size_type pos) const { return substr(pos, npos); }
    basic_string substr() const { return substr(0, npos); }

    size_type find(C c, size_type from) const {
        for (size_type i = from; i < len_; i++)
            if (buf_[i] == c) return i;
        return npos;
    }
    size_type find(C c) const { return find(c, 0); }

    size_type find(const C *s, size_type from) const {
        size_type n = __cxx1_length(s);
        if (n > len_) return npos;
        for (size_type i = from; i + n <= len_; i++)
            if (std::memcmp(buf_ + i, s, n * sizeof(C)) == 0) return i;
        return npos;
    }
    size_type find(const C *s) const { return find(s, 0); }
    size_type find(const basic_string &s, size_type from) const {
        return find(s.buf_, from);
    }
    size_type find(const basic_string &s) const { return find(s.buf_, 0); }

    size_type rfind(C c) const {
        for (size_type i = len_; i-- > 0; )
            if (buf_[i] == c) return i;
        return npos;
    }

    // The parameter is `wanted` and not `set`, which it was: once `<set>` is
    // included as well, `set` names a class template, and this compiler reads
    // the template in preference to the parameter that shadows it. A header
    // has no business using a library name for a parameter either way.
    size_type find_first_of(const C *wanted) const {
        for (size_type i = 0; i < len_; i++)
            if (__cxx1_holds(wanted, buf_[i])) return i;
        return npos;
    }
    size_type find_last_of(const C *wanted) const {
        for (size_type i = len_; i-- > 0; )
            if (__cxx1_holds(wanted, buf_[i])) return i;
        return npos;
    }
    // **The one-character forms**, which is how a path is usually split -
    // `path.find_last_of('/')`. A `char` reaches the `const char *` overload
    // through no conversion C++ has, so without these the call is refused.
    size_type find_first_of(C c) const { return find(c, 0); }
    size_type find_last_of(C c) const { return rfind(c); }

    basic_string &insert(size_type pos, const C *s) {
        size_type n = __cxx1_length(s);
        if (pos > len_) pos = len_;
        reserve(len_ + n);
        // Backwards, so that a move within one buffer cannot overwrite what it
        // has not read yet.
        for (size_type i = len_; i-- > pos; ) buf_[i + n] = buf_[i];
        for (size_type i = 0; i < n; i++) buf_[pos + i] = s[i];
        len_ += n;
        buf_[len_] = 0;
        return *this;
    }
    basic_string &insert(size_type pos, const basic_string &s) {
        return insert(pos, s.c_str());
    }

    basic_string &erase(size_type pos, size_type n) {
        if (pos > len_) return *this;
        size_type have = len_ - pos;
        if (n > have) n = have;
        for (size_type i = pos; i + n < len_; i++) buf_[i] = buf_[i + n];
        len_ -= n;
        buf_[len_] = 0;
        return *this;
    }
    basic_string &erase(size_type pos) { return erase(pos, npos); }

    int compare(const basic_string &o) const { return __cxx1_compare(buf_, o.buf_); }
    int compare(const C *s) const { return __cxx1_compare(buf_, s); }

private:
    // **The buffer is never null and always terminated**, so `c_str()` needs no
    // special case and neither does an empty string.
    void init(const C *s, size_type n) {
        cap_ = 0;
        buf_ = 0;
        reserveExactly(n);
        if (n != 0) std::memcpy(buf_, s, n * sizeof(C));
        len_ = n;
        buf_[len_] = 0;
    }
    void reserveExactly(size_type want) {
        size_type room = want < 15 ? 15 : want;
        C *fresh = (C *)std::malloc((room + 1) * sizeof(C));
        if (buf_ != 0) {
            std::memcpy(fresh, buf_, len_ * sizeof(C));
            std::free(buf_);
        } else {
            len_ = 0;
        }
        fresh[len_] = 0;
        buf_ = fresh;
        cap_ = room;
    }
    void assignFrom(const C *s, size_type n) {
        reserve(n);
        if (n != 0) std::memcpy(buf_, s, n * sizeof(C));
        len_ = n;
        buf_[len_] = 0;
    }
    basic_string &appendUnits(const C *s, size_type n) {
        if (n != 0) {
            // Grown by doubling and not by exactly what is wanted, so that
            // building a string one character at a time is not quadratic.
            if (len_ + n > cap_) {
                size_type want = cap_ * 2;
                reserveExactly(len_ + n > want ? len_ + n : want);
            }
            std::memcpy(buf_ + len_, s, n * sizeof(C));
            len_ += n;
            buf_[len_] = 0;
        }
        return *this;
    }

    C *buf_;
    size_type len_;
    size_type cap_;
};

typedef basic_string<char> string;
typedef basic_string<wchar_t> wstring;

// **The comparisons and the concatenations are non-members**, which is what
// lets `"a" + s` work as well as `s + "a"`: a member would need the left side
// to be the class.
//
// **`inline`, since 2026-09-19: one definition, merged across every translation
// unit that includes this.** They were `static` until then - a copy per unit -
// because cxx1 had no weak or linkonce linkage to give an inline function.
// Now it does on every target: `.weak` on the two GNU targets and the C6000,
// `.weak_def_can_be_hidden` on Mach-O, a COMDAT section on Windows in both
// spellings (the project's own MASM assembler took COMDAT on 2026-09-18).
template <class C> inline bool operator==(const basic_string<C> &a, const basic_string<C> &b) { return a.compare(b) == 0; }
template <class C> inline bool operator==(const basic_string<C> &a, const C *b) { return a.compare(b) == 0; }
template <class C> inline bool operator==(const C *a, const basic_string<C> &b) { return b.compare(a) == 0; }
template <class C> inline bool operator!=(const basic_string<C> &a, const basic_string<C> &b) { return a.compare(b) != 0; }
template <class C> inline bool operator!=(const basic_string<C> &a, const C *b) { return a.compare(b) != 0; }
template <class C> inline bool operator!=(const C *a, const basic_string<C> &b) { return b.compare(a) != 0; }
template <class C> inline bool operator<(const basic_string<C> &a, const basic_string<C> &b) { return a.compare(b) < 0; }
template <class C> inline bool operator>(const basic_string<C> &a, const basic_string<C> &b) { return a.compare(b) > 0; }
template <class C> inline bool operator<=(const basic_string<C> &a, const basic_string<C> &b) { return a.compare(b) <= 0; }
template <class C> inline bool operator>=(const basic_string<C> &a, const basic_string<C> &b) { return a.compare(b) >= 0; }

template <class C> inline basic_string<C> operator+(const basic_string<C> &a, const basic_string<C> &b) {
    basic_string<C> r(a);
    r += b;
    return r;
}
template <class C> inline basic_string<C> operator+(const basic_string<C> &a, const C *b) {
    basic_string<C> r(a);
    r += b;
    return r;
}
template <class C> inline basic_string<C> operator+(const C *a, const basic_string<C> &b) {
    basic_string<C> r(a);
    r += b;
    return r;
}
template <class C> inline basic_string<C> operator+(const basic_string<C> &a, C b) {
    basic_string<C> r(a);
    r += b;
    return r;
}
template <class C> inline basic_string<C> operator+(C a, const basic_string<C> &b) {
    basic_string<C> r(1, a);
    r += b;
    return r;
}

// **[string.conversions] to_string, and the digits come off the negative
// side.** `-v` is undefined for the most negative value of a signed type -
// there is no positive counterpart - so the loop runs on `x <= 0` and turns
// each remainder round with `'0' - x % 10`. C++11 fixed `%` to truncate toward
// zero, so a negative dividend gives a non-positive remainder and the
// subtraction is the digit.
inline string to_string(long long v) {
    char buf[24];
    int n = 0;
    bool neg = v < 0;
    long long x = neg ? v : -v;
    do {
        buf[n] = (char)('0' - (int)(x % 10));
        n++;
        x /= 10;
    } while (x != 0);
    if (neg) { buf[n] = '-'; n++; }
    string r;
    for (int i = n; i-- > 0; ) r += buf[i];
    return r;
}

inline string to_string(int v) { return to_string((long long)v); }
inline string to_string(long v) { return to_string((long long)v); }
inline string to_string(unsigned v) { return to_string((long long)v); }
inline string to_string(unsigned long v) { return to_string((long long)v); }

inline wstring to_wstring(long long v) {
    string s = to_string(v);
    wstring r;
    for (std::size_t i = 0; i < s.size(); i++) r += (wchar_t)s[i];
    return r;
}
inline wstring to_wstring(int v) { return to_wstring((long long)v); }

}  // namespace std

// After the class, so <stdexcept> can hold a string; it defines what `at` calls.
#include <stdexcept>

#endif
